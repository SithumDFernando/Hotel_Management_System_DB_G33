# =============================================================================
# .env.example — settings for docker-compose.yml (repo root)
# =============================================================================
# Copy to `.env` next to docker-compose.yml. Every value has a default in
# docker-compose.yml, so this file is optional for local development.
# (backend/.env is separate and only used when running uvicorn natively.)
# =============================================================================

# Postgres password for skynest_user. Changing it after the first run needs
# a reset: docker compose down -v
POSTGRES_PASSWORD=skynest_dev_pass

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# pgAdmin login (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@skynest.dev
PGADMIN_DEFAULT_PASSWORD=admin

# Host ports — change if something on your machine already uses them
# (e.g. a native PostgreSQL install on 5432 -> set DB_PORT=5433)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
PGADMIN_PORT=5050
