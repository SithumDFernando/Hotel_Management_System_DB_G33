# =============================================================================
# backend/.env.example
# =============================================================================
# Purpose:
#   Template for the backend's environment variables. Copy this file to `.env`
#   in the backend/ directory and fill in real values before running the server.
#   The .env file is gitignored — NEVER commit actual secrets to version control.
#
# Usage:
#   cp backend/.env.example backend/.env
#   (then edit backend/.env with your real values)
#
# Variables:
#
# DATABASE_URL
#   Full PostgreSQL connection string used by asyncpg / psycopg3.
#   Format: postgresql://<user>:<password>@<host>:<port>/<database>
#   Example: postgresql://skynest_user:supersecret@localhost:5432/skynest
#
# SECRET_KEY
#   A random 32-byte hex string used to sign JWT access tokens.
#   Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   Example: a3f8d2c1e4b5097f6a1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3
#
# ALGORITHM
#   JWT signing algorithm. HS256 is the standard for symmetric signing.
#   Default: HS256
#
# ACCESS_TOKEN_EXPIRE_MINUTES
#   How long a JWT token is valid (in minutes). After this, the user must log in again.
#   Default: 60 (1 hour). Use 1440 for 24-hour sessions during development.
#
# FRONTEND_ORIGIN
#   The URL of the React frontend. Used by CORS middleware to allow cross-origin
#   requests from the browser during development and production.
#   Dev default: http://localhost:5173   (Vite dev server)
#   Production: https://your-deployed-frontend.com
#
# =============================================================================

DATABASE_URL=postgresql://skynest_user:skynest_dev_pass@localhost:5432/skynest
SECRET_KEY=change_this_to_a_random_32_byte_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
